{
  "name": "quickdraw-extensions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/quickdraw",
